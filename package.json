{
  "name": "cslingo",
  "version": "1.0.0",
  "private": true,
  "description": "CSLingo: a Duolingo-style study app. Plain HTML/CSS/JS, no build step; this file only holds the dev tooling.",
  "scripts": {
    "serve": "python3 serve.py 8651",
    "lint": "eslint .",
    "format": "prettier --write \"js/**/*.js\" \"tools/*.js\" \"css/*.css\" \"*.js\"",
    "format:check": "prettier --check \"js/**/*.js\" \"tools/*.js\" \"css/*.css\" \"*.js\"",
    "test": "node tools/run-tests.js",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "globals": "^15.0.0",
    "playwright": "^1.50.0",
    "prettier": "^3.3.0"
  },
  "type": "module"
}
